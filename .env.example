# Default is an offline local experience; no cloud calls.
PORT=1842
HOST=127.0.0.1
APP_MODE=demo
# Live mode is disabled until existing FC access and OSS cleanup are reviewed.
# Never copy cloud secrets to VITE_* variables or browser code.
BAILIAN_API_KEY=
BAILIAN_BASE_URL=
BAILIAN_MODEL=qwen3.7-plus
BAILIAN_ENABLE_THINKING=false
CT_OSS_ACCESS_KEY_ID=
CT_OSS_ACCESS_KEY_SECRET=
CT_OSS_BUCKET=
CT_OSS_REGION=oss-cn-beijing
FC_DIAGNOSE_URL=
# Explicit integration prerequisite; do not enable just to bypass a failure.
LIVE_INTEGRATION_APPROVED=false

# Parent-directory credential discovery is retired; fill only this project configuration.
USE_CONTAINER_CREDENTIALS=false
