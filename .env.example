# Default is an offline local experience; no cloud calls.
PORT=1842
HOST=127.0.0.1
APP_MODE=demo
# The main model is DeepSeek V4.1 Flash; demo mode still makes no cloud calls.
# Never copy model or cloud secrets to VITE_* variables or browser code.
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-flash
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=
MODEL_ENABLE_THINKING=true
MODEL_REASONING_EFFORT=high
MODEL_MAX_TOKENS=32768

# Optional legacy rollback provider. Set MODEL_PROVIDER=bailian to use these.
BAILIAN_API_KEY=
BAILIAN_BASE_URL=
BAILIAN_MODEL=qwen3.7-plus
BAILIAN_ENABLE_THINKING=false
CT_OSS_ACCESS_KEY_ID=
CT_OSS_ACCESS_KEY_SECRET=
CT_OSS_BUCKET=
CT_OSS_REGION=oss-cn-beijing
FC_DIAGNOSE_URL=
# Explicit integration prerequisite; do not enable just to bypass a failure.
LIVE_INTEGRATION_APPROVED=false

# Parent-directory credential discovery is retired; fill only this project configuration.
USE_CONTAINER_CREDENTIALS=false

# Main Agent tokens per anonymous session; resets after two hours without interaction.
SESSION_TOKEN_LIMIT=10000000
