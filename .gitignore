# Public repository allowlist. Local project history remains on this machine.
/*
!/.gitignore
!/.dockerignore
!/.env.example
!/README.md
!/RELEASING.md
!/package.json
!/package-lock.json
!/index.html
!/vite.config.js
!/Dockerfile
!/src/
!/server/
!/skills/
!/contracts/
!/tests/
!/scripts/
!/knowledge/
!/public/
!/deploy/
!/.github/
/public/*
!/public/hifun-agent-avatar.png
!/public/user-avatar.png
!/public/theme-init.js
/knowledge/*
!/knowledge/source/
!/knowledge/snapshot.json
!/knowledge/README.md
/deploy/*
!/deploy/start-container.sh
!/deploy/smoke-container.mjs
!/deploy/wehifun.conf
**/.env
**/.env.*
!/.env.example
**/*.pem
**/*.key
**/.DS_Store
